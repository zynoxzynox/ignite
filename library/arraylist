local library = {}
local TextService = game:GetService("TextService")

function library.new(config)
    local screenGui = Instance.new("ScreenGui", game.CoreGui)
    
    local container = Instance.new("Frame", screenGui)
    container.Size = UDim2.new(0.2, 0, 1, 0)
    container.Position = UDim2.new(0.8, -20, 0, 20) -- Aligned Right
    container.BackgroundTransparency = 1
    
    local layout = Instance.new("UIListLayout", container)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    layout.VerticalAlignment = Enum.VerticalAlignment.Top
    layout.Padding = UDim.new(0, config.Padding)
    layout.SortOrder = Enum.SortOrder.LayoutOrder

    return {
        add = function(name, color)
            local label = Instance.new("TextLabel", container)
            label.Name = name
            label.Text = name
            label.Font = config.Font
            label.TextSize = config.FontSize
            label.TextColor3 = color
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Right
            
            local size = TextService:GetTextSize(name, config.FontSize, config.Font, Vector2.new(1000, 1000))
            label.Size = UDim2.new(0, size.X, 0, size.Y)
            
            label.LayoutOrder = -size.X 
            
            label.TextStrokeTransparency = 0.8
            label.TextStrokeColor3 = Color3.new(0,0,0)
        end
    }
end

return library
