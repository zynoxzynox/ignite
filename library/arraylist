local library = {}
local TextService = game:GetService("TextService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

function library.new(config)
    local screenGui = Instance.new("ScreenGui", game.CoreGui)
    screenGui.IgnoreGuiInset = true
    
    local container = Instance.new("Frame", screenGui)
    container.Size = UDim2.new(0, 500, 1, 0)
    container.Position = UDim2.new(1, -10, 0, 10)
    container.AnchorPoint = Vector2.new(1, 0)
    container.BackgroundTransparency = 1
    
    local layout = Instance.new("UIListLayout", container)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    layout.VerticalAlignment = Enum.VerticalAlignment.Top
    layout.Padding = UDim.new(0, config.Padding or 2)
    layout.SortOrder = Enum.SortOrder.LayoutOrder

    local activeLabels = {}

    return {
        add = function(name)
            if activeLabels[name] then return end 
            
            local label = Instance.new("TextLabel", container)
            label.Text = name
            label.Font = config.Font or Enum.Font.Inter
            label.TextSize = config.TextSize or 25
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Right
            
            local size = TextService:GetTextSize(name, label.TextSize, label.Font, Vector2.new(1000, 1000))
            label.Size = UDim2.new(0, size.X, 0, size.Y)
            label.LayoutOrder = -size.X 
            
            label.Position = UDim2.new(0, 30, 0, 0)
            label.TextTransparency = 1
            
            if config.Rainbow then
                local connection
                connection = RunService.RenderStepped:Connect(function()
                    if not label or not label.Parent then connection:Disconnect() return end
                    local hue = (tick() % 5 / 5)
                    label.TextColor3 = Color3.fromHSV(hue, 0.8, 1)
                end)
            else
                label.TextColor3 = config.MainColor or Color3.new(1,1,1)
            end
            
            TweenService:Create(label, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = UDim2.new(0, 0, 0, 0),
                TextTransparency = 0
            }):Play()
            
            activeLabels[name] = label
        end,
        
        remove = function(name)
            local label = activeLabels[name]
            if label then
                activeLabels[name] = nil
                
                local tween = TweenService:Create(label, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                    Position = UDim2.new(0, 30, 0, 0),
                    TextTransparency = 1
                })
                
                tween:Play()
                tween.Completed:Connect(function()
                    label:Destroy()
                end)
            end
        end
    }
end

return library


